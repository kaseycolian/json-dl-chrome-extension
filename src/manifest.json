{
  "manifest_version": 3,
  "name": "JSON Interceptor",
  "version": "1.0",
  "description": "Intercept and download JSON responses from specific endpoints",
  "devtools_page": "devtools.html",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads",
    "storage"
  ]
}
